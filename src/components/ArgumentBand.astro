---
// The argument, as one dark band directly below the masthead.
//
// The page previously asserted "Both descriptions are true of the same system.
// Only one of them is a design input" while showing only one description. Three
// synthetic stat rows are not a contrast — they are the same kind of number
// three times. This band puts the annual figure and the hourly trace side by
// side, which is the whole course in one frame.
//
// The annual figure is registered at content/figures/annual-renewable-share.json
// as class: synthetic with a declared recompute exemption: an annual energy
// share is not derivable from a fourteen-day capacity-factor trace, so it must
// not pretend to be. It is read from that record rather than typed here.
import ProvenanceTag from "./ProvenanceTag.astro";
import annual from "../../content/figures/annual-renewable-share.json";
import {
  EVENT_LENGTH_HOURS,
  EVENT_START_HOUR,
  THRESHOLD_PCT,
  TRACE_HOURS,
  trace,
} from "../lib/trace";

const W = 640;
const H = 210;
const PAD = { l: 30, r: 10, t: 26, b: 22 };
const MAX = 70;
const plotW = W - PAD.l - PAD.r;
const plotH = H - PAD.t - PAD.b;

const gx = (h: number) => PAD.l + (h / (TRACE_HOURS - 1)) * plotW;
const gy = (v: number) => PAD.t + plotH - (Math.min(v, MAX) / MAX) * plotH;

const area =
  `M${gx(0).toFixed(1)} ${gy(0).toFixed(1)} ` +
  trace.total.map((v, i) => `L${gx(i).toFixed(1)} ${gy(v).toFixed(1)}`).join(" ") +
  ` L${gx(TRACE_HOURS - 1).toFixed(1)} ${gy(0).toFixed(1)} Z`;

const evX = gx(EVENT_START_HOUR);
const evW = gx(EVENT_START_HOUR + EVENT_LENGTH_HOURS) - evX;
---

<!-- The probe is never shifted, so its left edge is the band's natural left
     edge. BaseLayout's `hero` slot is the mechanism the hero uses to reach the
     body grid's `full` line, and it is already occupied; inside .at-main's
     subgrid `full` does not resolve. Measuring is exact where re-deriving the
     theme's column maths would only be nearly right. -->
<span class="ab-probe" aria-hidden="true"></span>

<section class="ab" aria-labelledby="ab-title">
  <div class="ab-inner">
    <!-- Full inner width, above the columns. At 44px "Then Thursday happened."
         needs 531px and the 42fr column is 343px, so inside that column the
         sentence overflowed it by 188px and ran into the chart's gutter —
         text-wrap: nowrap reported two lines while hiding that. Spanning the
         row keeps the specified size, the specified split and two honest
         lines. -->
    <h2 id="ab-title" class="ab-head">
      <span class="ab-line">The average looked fine.</span>
      <span class="ab-line">Then Thursday happened.</span>
    </h2>

    <div class="ab-left">
      <p class="ab-figure">
        <span class="ab-value">{annual.value}{annual.unit}</span>
        <span class="ab-caption">{annual.label}</span>
        <ProvenanceTag kind="synthetic" />
      </p>
    </div>

    <figure class="ab-right">
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-labelledby="ab-alt">
        <rect x={evX} y={PAD.t} width={evW} height={plotH} class="trough trough--on-dark" />
        <line x1={PAD.l} x2={W - PAD.r} y1={gy(0)} y2={gy(0)} class="ab-axis" />
        <path d={area} class="ab-area" />
        <line x1={PAD.l} x2={W - PAD.r} y1={gy(THRESHOLD_PCT)} y2={gy(THRESHOLD_PCT)} class="ab-thr" />
        <text x={PAD.l - 5} y={gy(0) + 3} class="ab-tick">0%</text>
        <text x={PAD.l - 5} y={gy(THRESHOLD_PCT) + 3} class="ab-tick">{THRESHOLD_PCT}%</text>
        <text x={PAD.l - 5} y={gy(MAX) + 8} class="ab-tick">{MAX}%</text>
        <text x={evX + evW / 2} y={PAD.t - 9} class="ab-evlbl">
          {`${EVENT_LENGTH_HOURS} HOURS BELOW ${THRESHOLD_PCT}%`}
        </text>
      </svg>
      <figcaption id="ab-alt" class="visually-hidden">
        Combined wind and solar output across the same fourteen days, hour by
        hour. Output holds well above the {THRESHOLD_PCT}% threshold for most of
        the fortnight and then falls below it for {EVENT_LENGTH_HOURS} consecutive
        hours from day 8 — the event the annual figure does not mention.
      </figcaption>
    </figure>

    <p class="ab-foot">
      The same system, hour by hour. One number describes it. So does the other.
    </p>
  </div>
</section>

<script is:inline>
  (() => {
    const set = () => {
      const probe = document.querySelector(".ab-probe");
      if (!probe) return;
      const root = document.documentElement;
      root.style.setProperty("--ab-edge", `${probe.getBoundingClientRect().left}px`);
      root.style.setProperty("--ab-vw", `${root.clientWidth}px`);
    };
    set();
    addEventListener("resize", set);
    addEventListener("load", set);
  })();
</script>

<style>
  .ab-probe {
    display: block;
    height: 0;
  }

  /* Full-bleed dark band. Breaks the cream column that otherwise runs
     uninterrupted from the masthead to the footer, which is what flattens the
     page's rhythm. */
  .ab {
    grid-column: full;
    /* Pulled back to the viewport's left edge and given its exact width. The
       fallbacks keep the band in its column if the script never runs. */
    margin-inline-start: calc(-1 * var(--ab-edge, 0px));
    width: var(--ab-vw, auto);
    margin-block: var(--at-spacing-xl);
    padding-block: clamp(40px, 5vw, 64px);
    padding-inline: var(--at-gutter);
    min-height: clamp(320px, 28vw, 420px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--ground);
    color: #f6efdd;
  }

  .ab-inner {
    display: grid;
    grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
    column-gap: 48px;
    row-gap: 24px;
    align-items: center;
    max-width: var(--at-content-width);
    margin-inline: auto;
  }

  /* One line per sentence. text-wrap: balance was redistributing the two
     sentences across four lines, which broke them mid-clause. */
  .ab-head {
    grid-column: 1 / -1;
    margin-block: 0;
    font-size: clamp(28px, 3.2vw, 44px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #f6efdd;
    text-wrap: nowrap;
  }

  .ab-line {
    display: block;
  }

  /* One unit, not three islands: gap rather than margins, so the number, its
     label and its provenance note sit together under the headline. */
  .ab-figure {
    display: grid;
    gap: 6px;
    margin: 0;
    justify-items: start;
  }

  .ab-value {
    font-family: var(--at-font-mono);
    font-size: clamp(36px, 4.4vw, 48px);
    font-weight: 500;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--at-primary);
  }

  .ab-caption {
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(246 239 221 / 62%);
  }

  .ab-right {
    margin: 0;
    min-width: 0;
  }

  .ab-right svg {
    display: block;
    width: 100%;
    height: 176px;
  }

  .ab-area {
    fill: rgb(168 119 34 / 34%);
    stroke: var(--at-primary);
    stroke-width: 1.6;
  }

  .ab-thr {
    stroke: rgb(246 239 221 / 70%);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
  }

  .ab-axis {
    stroke: rgb(246 239 221 / 25%);
    stroke-width: 1;
  }

  .ab-tick {
    font-family: var(--at-font-mono);
    font-size: 10px;
    fill: rgb(246 239 221 / 62%);
    text-anchor: end;
  }

  .ab-evlbl {
    font-family: var(--at-font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    fill: #f6efdd;
    text-anchor: middle;
  }

  /* A row of the inner grid. As a sibling of .ab-inner it had its own
     max-width and auto margins, which centred it against the full-bleed band
     instead of against the columns above it. */
  .ab-foot {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--at-font-size-sm);
    color: rgb(246 239 221 / 72%);
  }

  @media (width < 48rem) {
    .ab-inner {
      grid-template-columns: 1fr;
      gap: var(--at-spacing-lg);
    }

    .ab-right svg {
      height: 170px;
    }
  }
</style>
