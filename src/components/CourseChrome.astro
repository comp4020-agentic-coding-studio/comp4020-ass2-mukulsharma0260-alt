---
// The course layer's own chrome, added as a component rather than by re-routing
// every page through one layout.
//
// PageLayout.astro is only the defaultLayout for the .md/.mdx pages; the six
// .astro pages import ContentLayout or BaseLayout directly. So there is no
// single layout to hang site-wide additions on, and README:18-22 permits the
// cheaper route: "adding is always allowed ... a component the theme doesn't
// have."
//
// Imported at the top of all seven entry points. spec/chrome.test.ts asserts
// every built page carries what this emits, so "on every page" is mechanical
// rather than hand-maintained — which was the actual defect.
//
// The strip is the course's signature at 22px: the same fortnight, the same
// trough, the same wash and threshold convention as every other appearance of
// it. A marker sampling two non-adjacent pages meets the same event twice
// without being told to look for it.
import {
  EVENT_LENGTH_HOURS,
  EVENT_START_HOUR,
  THRESHOLD_PCT,
  TRACE_HOURS,
  trace,
} from "../lib/trace";

const W = 1200;
const H = 22;
const MAX = 70;
const gx = (h: number) => (h / (TRACE_HOURS - 1)) * W;
const gy = (v: number) => H - (Math.min(v, MAX) / MAX) * H;

const area =
  `M0 ${H} ` +
  trace.total.map((v, i) => `L${gx(i).toFixed(1)} ${gy(v).toFixed(1)}`).join(" ") +
  ` L${W} ${H} Z`;
const evX = gx(EVENT_START_HOUR);
const evW = gx(EVENT_START_HOUR + EVENT_LENGTH_HOURS) - evX;
---

<div class="cc-strip">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    role="img"
    aria-label={`The course's fourteen-day teaching trace at a glance: combined wind and solar output holds above the ${THRESHOLD_PCT}% threshold for most of the fortnight, then falls below it for ${EVENT_LENGTH_HOURS} consecutive hours — the reference event this course is about.`}
  >
    <rect x={evX} y="0" width={evW} height={H} class="cc-ev" />
    <path d={area} class="cc-area" />
    <line x1="0" x2={W} y1={gy(THRESHOLD_PCT)} y2={gy(THRESHOLD_PCT)} class="cc-thr" />
  </svg>
</div>

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Newsreader:opsz,ital,wght@6..72,0,300..600;6..72,1,300..500&display=swap"
/>

<style is:global>
  /* Four type roles, and the split carries meaning: institution / argument /
     instrument. The university speaks in its own face; the course speaks in a
     different one on top of it.
     --ui and --mono alias the theme's self-hosted Public Sans and Roboto Mono
     and are untouched: astro.config.ts requires --font-public-sans for deck
     compilation, and README fixes that file. Only --disp and --serif are new. */
  :root {
    --ui: var(--at-font-body);
    --mono: var(--at-font-mono);
    --disp: "Fraunces", "Iowan Old Style", Georgia, serif;
    --serif: "Newsreader", Georgia, "Times New Roman", serif;
  }

  /* Argument: all reading prose. */
  .at-main :is(p, li, dd, blockquote, figcaption) {
    font-family: var(--serif);
  }

  /* Display: headings, and the claims that behave like headings. */
  .at-main :is(h1, h2, h3, h4),
  .at-main .wk-claim,
  .ab-head {
    font-family: var(--disp);
    font-optical-sizing: auto;
  }

  /* Instrument: the institution's chrome keeps its own face, and anything
     measured keeps tabular figures so digits align down a column. */
  .at-nav,
  .at-footer {
    font-family: var(--ui);
  }

  .instr-hud dd,
  .hm-num,
  .ab-value,
  .cc-strip-label {
    font-variant-numeric: tabular-nums;
  }
</style>

<style>
  /* Full-bleed under the nav. Decorative-but-labelled: it repeats the figure
     the site already explains, so it carries an aria-label stating the finding
     rather than the shape. */
  .cc-strip {
    grid-column: full;
    margin-block: 0 var(--at-spacing-lg);
    border-block-end: 1px solid var(--at-divider);
    background: var(--at-bg-alt);
  }

  .cc-strip svg {
    display: block;
    width: 100%;
    height: 22px;
  }

  /* Identical conventions to every other appearance of the trough: a
     translucent wash behind the data, never an opaque fill. */
  .cc-ev {
    fill: rgb(26 22 17 / 8.5%);
  }

  :root[data-theme="dark"] .cc-ev {
    fill: rgb(255 246 225 / 7%);
  }

  .cc-area {
    fill: var(--at-accent-soft);
    stroke: var(--at-accent);
    stroke-width: 1;
  }

  .cc-thr {
    stroke: var(--at-text-muted);
    stroke-width: 1;
    stroke-dasharray: 4 3;
  }
</style>
