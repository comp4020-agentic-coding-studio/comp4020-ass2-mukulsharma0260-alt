---
import MdxPageLayout from "astro-theme-university/layouts/MdxPageLayout.astro";
import CourseChrome from "../components/CourseChrome.astro";
import { siteConfig } from "../site-config";
---

<MdxPageLayout siteConfig={siteConfig} {...Astro.props}>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Newsreader:opsz,ital,wght@6..72,0,300..600;6..72,1,300..500&display=swap"
  />
  <slot />
</MdxPageLayout>

<style is:global>
  /* Four type roles, and the split carries meaning: institution / argument /
     instrument. The university speaks in its own face; the course speaks in a
     different one on top of it.
     --ui and --mono alias the theme's self-hosted Public Sans and Roboto Mono,
     untouched — astro.config.ts requires --font-public-sans for deck
     compilation and README fixes that file. Only --disp and --serif are new. */
  :root {
    --ui: var(--at-font-body);
    --mono: var(--at-font-mono);
    --disp: "Fraunces", "Iowan Old Style", Georgia, serif;
    --serif: "Newsreader", Georgia, "Times New Roman", serif;
  }

  /* Argument: all reading prose. */
  .at-main :is(p, li, dd, blockquote, figcaption) {
    font-family: var(--serif);
  }

  /* Display: headings and the claims that behave like headings. */
  .at-main :is(h1, h2, h3, h4),
  .at-main .wk-claim,
  .ab-head {
    font-family: var(--disp);
    font-optical-sizing: auto;
  }

  /* Instrument: anything measured keeps tabular figures so digits align. */
  .at-main :is(.instr, .ev-spec, .wk-spec, .as-spec, .hm-stats) [class*="-v"],
  .instr-hud dd,
  .hm-num,
  .ab-value {
    font-variant-numeric: tabular-nums;
  }

  /* The theme's heading-autolink plugin emits a literal "#" text node inside
     every heading, which renders as visible punctuation ("The Failure Wall #").
     The plugin lives in the fixed build pipeline, so this suppresses the glyph
     site-wide from the layer README:76-78 designates as ours, instead of
     editing astro.config.ts.
     The anchor stays in the DOM and keeps working as a link target; it is
     already aria-hidden and tabindex="-1", so hiding the glyph removes nothing
     from assistive technology. It reappears on hover/focus-within for anyone
     who wants to copy a section link. */
  .at-heading-anchor {
    font-size: 0;
    line-height: 0;
    opacity: 0;
    margin-inline-start: 0.35em;
  }

  :is(h1, h2, h3, h4, h5, h6):hover > .at-heading-anchor,
  .at-heading-anchor:focus-visible {
    font-size: 0.7em;
    line-height: 1;
    opacity: 0.55;
  }
</style>
