---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import Callout from "astro-theme-university/components/Callout.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import CourseChrome from "../../components/CourseChrome.astro";
import DispatchConsole from "../../components/DispatchConsole.astro";
import MarkingModel from "../../components/MarkingModel.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const assessments = await getPublishedCollection("assessments");
  return assessments.map((assessment) => ({
    params: { slug: assessment.id },
    props: { assessment },
  }));
}

const { assessment } = Astro.props;
const { Content } = await render(assessment);
---

<ContentLayout
  title={assessment.data.title}
  description={assessment.data.description}
  {...siteConfig}
>
  <CourseChrome />

  {
    assessment.data.draft && (
      <Callout type="warning">
        <p>
          <strong>Draft.</strong> This brief is still being finalised and may change.
        </p>
      </Callout>
    )
  }
  <p class="as-eyebrow">
    Stage {assessment.data.stage} of 4 · {assessment.data.coversWeeks}
  </p>

  <dl class="as-spec">
    <div class="as-spec-row">
      <dt>Due</dt>
      <dd>{formatCourseDate(assessment.data.due)}</dd>
    </div>
    <div class="as-spec-row">
      <dt>Weight</dt>
      <dd>{assessment.data.weight}% of the course</dd>
    </div>
    <div class="as-spec-row">
      <dt>Takes as input</dt>
      <dd>{assessment.data.takesInput ?? "Nothing — this is the first stage"}</dd>
    </div>
    <div class="as-spec-row">
      <dt>Produces</dt>
      <dd>{assessment.data.produces}</dd>
    </div>
  </dl>

  <Content />

  {assessment.data.stage === 3 && <DispatchConsole />}

  <SpecList spec={assessment.data.spec}>
    The brief poses the problem and leaves room for a response. The spec is the
    fixed part: what a marker checks. Some lines can be checked mechanically;
    the rest call for judgement.
  </SpecList>
  {assessment.data.marking && <MarkingModel marking={assessment.data.marking} />}
  <RelatedContent entry={assessment} collections={graphCollections} />
</ContentLayout>

<style>
  .as-eyebrow {
    order: -1;
    margin-block: 0 var(--at-spacing-xs);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-text-muted);
  }

  /* The ladder's structural fields, in the same instrument register as the
     event page's definition card. */
  .as-spec {
    grid-column: inset-start / content-end;
    margin-block: var(--at-spacing-lg) var(--at-spacing-xl);
    border-block-start: 1px solid var(--at-border);
    font-size: var(--at-font-size-sm);
  }

  .as-spec-row {
    display: grid;
    padding-inline-start: var(--at-content-inset);
    grid-template-columns: minmax(9rem, 13rem) 1fr;
    gap: 0 var(--at-spacing-md);
    padding-block: var(--at-spacing-sm);
    border-block-end: 1px solid var(--at-divider);
  }

  .as-spec dt {
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--at-text-muted);
    padding-block-start: 0.15em;
  }

  .as-spec dd {
    margin: 0;
    color: var(--at-text);
  }

  @media (width < 34rem) {
    .as-spec-row {
      grid-template-columns: 1fr;
    }
  }
</style>
