---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import CourseChrome from "../../components/CourseChrome.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Twelve weeks, twelve claims. Each studio owns one property of the event, and no two own the same one."
  {...siteConfig}
>
  <CourseChrome />

  <p>
    The seminar makes the week's argument; the studio is where you test it
    against the shared trace. Every week states the one property of the event
    it owns, whether it advances, complicates or challenges the course's
    central claim, and what the following week needs from it.
  </p>
  <p>
    All twelve resolve against one definition, at{" "}
    <a href={withBase("/the-event/")}>the event</a>.
  </p>
  <SessionsGrid />
</ContentLayout>
